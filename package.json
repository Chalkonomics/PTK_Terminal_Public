{
  "name": "ptk-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Hyperliquid 1m scalp entry tool",
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "setup": "npm ci && install-electron --no",
    "dev": "concurrently -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "0.33.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.5",
    "lucide-react": "1.52.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.5.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.2",
    "wait-on": "9.5.1"
  }
}
