# Copy this file to .env and fill in your own values. Never commit .env.
# Settings are read at startup, so restart the app after editing.

# --- Hyperliquid API (agent) wallet private keys ---------------------------
# Create one in the Hyperliquid UI (API section) and approve it on-chain.
# Use a separate API wallet for each network, and NEVER your main wallet's key.
# Format: 0x followed by 64 hex characters (a private key, not a 42-character address).
# Dry run needs neither key.

# Used when "mode" is "testnet" in config.json
HL_AGENT_KEY_TESTNET=

# Used when "mode" is "live" in config.json. This key trades real money.
HL_AGENT_KEY_MAINNET=

# --- Notion sync and trades dashboard (optional) ---------------------------
# Only needed if "notionSync" is true in config.json. See features/existing/notion-sync.md.
# Token: Notion → Settings → Connections → create an internal connection.
# Database ID: the 32-character ID in your Trades database's URL.
# Share the database with the connection (••• → Connections).
NOTION_TOKEN=
NOTION_DATABASE_ID=
